# ==============================================================================
# NoStrategia - Comprehensive .gitignore for Multi-Service Telemetry Platform
# (Covers: .NET 8 Edge Agent, Go API, Node.js / Next.js UI, Redis, TimescaleDB,
#  Wine/CrossOver artifacts, Docker volumes, and OS/IDE metadata)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.pfx
secrets/
appsettings.Development.json
appsettings.Production.json
appsettings.*.local.json
# Allow example environment file
!.env.example

# ------------------------------------------------------------------------------
# 2. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 3. IDEs & Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (Rider, GoLand, WebStorm, IDEA)
.idea/
*.iws
*.iml
*.ipr
out/

# Visual Studio / Roslyn
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Vim / Emacs
*.swp
*.swo
*#
.#*

# ------------------------------------------------------------------------------
# 4. .NET 8 / C# (Edge Ingestion Agent)
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
dist/
*.publishproj
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Native AOT build intermediates
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc

# ------------------------------------------------------------------------------
# 5. Go (Ingestion API Gateway & Go Analytics Services)
# ------------------------------------------------------------------------------
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
/pkg/

# Test binary, output of 'go test -c'
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Dependency directories (vendor directory should be ignored unless vendored)
vendor/
go.work

# ------------------------------------------------------------------------------
# 6. Node.js, Next.js & Frontend (Web Dashboard)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp/
.pnp.js

# Build and Production outputs
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js telemetry and cache
.next/cache/

# Cypress / Playwright test reports
/cypress/videos/
/cypress/screenshots/
/playwright-report/
/test-results/

# ------------------------------------------------------------------------------
# 7. Databases, Docker Volumes & Message Brokers
# ------------------------------------------------------------------------------
# PostgreSQL / TimescaleDB data directories mounted locally
pgdata/
timescaledb_data/
*.sql.gz
*.sql.tar

# Redis persistence dumps
dump.rdb
appendonly.aof
appendonlydir/
redis_data/

# Docker Desktop / OrbStack local mounts
docker-volumes/

# ------------------------------------------------------------------------------
# 8. Wine / CrossOver / Emulation Artifacts
# ------------------------------------------------------------------------------
# Bottles and Wine prefixes (prevent committing gigabytes of emulated Windows OS)
.wine/
crossover_bottle/
drive_c/
dosdevices/
*.reg.bak
winetricks.log

# ------------------------------------------------------------------------------
# 9. Telemetry Data, Raw Traces & Load Test Dumps (Large Files)
# ------------------------------------------------------------------------------
recordings/
dumps/
traces/
*.ndjson
*.rawbin
*.csv
# Allow mock sample recordings specifically stored in tests/fixtures
!tests/fixtures/*.ndjson
!tests/fixtures/*.csv

# k6 load testing outputs
k6-results/
*.k6.json
summary.html

# ------------------------------------------------------------------------------
# 10. Temporary & Scratch Files
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
*.bak
*.orig
