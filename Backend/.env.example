# ========================================================
# NoStrategia Telemetry Backend Environment Variables
# ========================================================

# Host Port Mappings
INGESTION_PORT=4000
REDIS_PORT=6379
TIMESCALE_PORT=5433

# Database (TimescaleDB / PostgreSQL 16)
POSTGRES_DB=telemetry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@timescaledb:5432/telemetry?sslmode=disable

# Redis Streams Broker
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_TELEMETRY=stream:telemetry:raw
REDIS_STREAM_SETUPS=stream:setups
STREAM_MAXLEN=10000

# Ingestion API Settings
PORT=4000
HOST=0.0.0.0
FIBER_PREFORK=false
CIRCUIT_BREAKER_MAX_FAILURES=5
