# NoStrategia WebSocket Gateway Configuration
WS_PORT=4001
WS_HOST=0.0.0.0

# Redis Connection (Backend Ingestion stream buffer)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_TELEMETRY=stream:telemetry:raw
REDIS_CONSUMER_GROUP=cg:gateway

# Stream simulation settings (when Redis has no live stream)
SIMULATION_ENABLED=true
SIMULATION_TICK_RATE_HZ=60

# Frontend Next.js Public Environment
NEXT_PUBLIC_WS_URL=ws://localhost:4001/ws/stream
