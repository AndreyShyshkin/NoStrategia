{
  "name": "nostrategia-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "NoStrategia High-Performance Next.js Telemetry Dashboard & WebSocket Gateway",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "gateway": "tsx server/gateway.ts",
    "gateway:dev": "tsx watch server/gateway.ts",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,NEXT\" -c \"cyan.bold,magenta.bold\" \"npm run gateway\" \"npm run dev\"",
    "test": "node --test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
